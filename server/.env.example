# PostgreSQL Database Connection URL (e.g. Neon, Supabase, Railway)
DATABASE_URL="postgresql://username:password@host:5432/database?sslmode=require"

# Clerk Authentication Keys (From Clerk Dashboard -> API Keys)
CLERK_PUBLISHABLE_KEY="pk_test_your_clerk_publishable_key"
CLERK_SECRET_KEY="sk_test_your_clerk_secret_key"

# Clerk Webhook Secret (From Clerk Dashboard -> Webhooks -> Signing Secret)
CLERK_WEBHOOK_SECRET="whsec_your_clerk_webhook_signing_secret"

# Server Configuration
PORT=5001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
